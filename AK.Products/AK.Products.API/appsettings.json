{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDbSettings": {
    "DatabaseName": "antkart-products",
    "ProductsCollection": "products"
  },
  "CosmosDb": {
    "KeyVaultUri": "https://kv-antkart-dev.vault.azure.net/",
    "SecretName": "cosmos-connection-string"
  },
  "DiscountGrpc": {
    "Address": "http://localhost:5001"
  },
  "Keycloak": {
    "Authority": "http://localhost:8090/realms/antkart",
    "Audience": "antkart-client",
    "RequireHttpsMetadata": false,
    "AdminUrl": "http://localhost:8090",
    "Realm": "antkart",
    "ClientId": "antkart-client",
    "ClientSecret": "antkart-secret"
  },
  "ServiceBus": {
    "FullyQualifiedNamespace": "sb-antkart-dev.servicebus.windows.net"
  },
  "Elasticsearch": {
    "Url": ""
  },
  "AllowedHosts": "*"
}
